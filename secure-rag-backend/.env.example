# ── Application ────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-minimum-32-characters-long-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
ENVIRONMENT=development

# ── AI Providers ───────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# Model selection (change without touching code)
EMBEDDING_MODEL=local
EMBEDDING_DIMENSIONS=384
GENERATION_MODEL=models/gemini-3.6-flash
LLM_TIMEOUT_SECONDS=25

# ── Vector Store ────────────────────────────────────────────────────────────────
# For local embedded storage use: ./data/qdrant_db
# For standalone Qdrant server use: http://localhost:6333
QDRANT_URL=./data/qdrant_db
QDRANT_COLLECTION=enterprise_rag_v2

# ── Retrieval ──────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=10
RERANK_TOP_K=3
RRF_K=60

# ── Confidence Gate ─────────────────────────────────────────────────────────────
# IMPORTANT: Calibrate this using:  python evaluation/evaluate.py --calibrate
# Do NOT choose arbitrarily. See docs/decisions/003-confidence-calibration.md
CONFIDENCE_THRESHOLD=0.45
CONFIDENCE_WEIGHT_RERANKER=0.45
CONFIDENCE_WEIGHT_RRF=0.25
CONFIDENCE_WEIGHT_DENSITY=0.20
CONFIDENCE_WEIGHT_ALIGNMENT=0.10

# ── Document Processing ────────────────────────────────────────────────────────
CHUNK_SIZE=500
CHUNK_OVERLAP=50
OCR_MIN_TEXT_CHARS=50
OCR_ENABLED=true   # Requires tesseract binary: apt-get install tesseract-ocr

# ── Storage ────────────────────────────────────────────────────────────────────
SQLITE_DB_PATH=./data/document_registry.db
DATABASE_URL=sqlite+aiosqlite:///./data/users.db
UPLOAD_DIR=./data/uploads

# ── Observability ──────────────────────────────────────────────────────────────
LOG_QUERY_TRACES=true
TRACE_LOG_PATH=./data/traces.jsonl
